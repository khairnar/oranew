# ORA Tenant Assessment Simulator — provider credentials
#
# PLACEHOLDERS ONLY. Never commit a real credential to this file.
# Copy it to `.env.local` (git-ignored) and fill the values there:
#
#     cp .env.example .env.local
#
# Every variable here is read SERVER-SIDE ONLY, in
# `src/lib/providers/config.ts`, which is marked `server-only`. None is
# prefixed `NEXT_PUBLIC_`, so none can reach the browser bundle.

# ---------------------------------------------------------------------------
# Prefill — POST /api/v1/prefill/prefill-by-mobile
#
# Authentication CONFIRMED from Surepass's Prefill by Mobile documentation:
#     Authorization: Bearer <token>
#     Content-Type: application/json
# ---------------------------------------------------------------------------
PREFILL_API_BASE_URL=https://kyc-api.surepass.app
PREFILL_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..drYYOTyXZzWMNk28klWg0x5cr-n107ggNXd5Z-GPsOg


# ---------------------------------------------------------------------------
# CIBIL — POST /api/v1/credit-report-cibil/fetch-report
#     Authorization: Bearer <token>
# ---------------------------------------------------------------------------
CIBIL_API_BASE_URL=https://kyc-api.surepass.app
CIBIL_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..drYYOTyXZzWMNk28klWg0x5cr-n107ggNXd5Z-GPsOg

# ---------------------------------------------------------------------------
# ONE SUREPASS TOKEN COVERS BOTH PRODUCTS
#
# Confirmed by live testing: Prefill and CIBIL authenticate with the SAME
# Surepass token, under the same header. Put that one token in both variables
# above, or set SUREPASS_TOKEN once and let both fall back to it:
#
#     Prefill : PREFILL_API_KEY  → SUREPASS_TOKEN
#     CIBIL   : CIBIL_API_TOKEN  → SUREPASS_TOKEN
#
# Either route works. The API Integration Test screen names the variable that
# supplied each credential, and warns when both resolve to the same one, so
# the resolution is always visible.
#
# SUREPASS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..drYYOTyXZzWMNk28klWg0x5cr-n107ggNXd5Z-GPsOg

# SUREPASS_BASE_URL is accepted as a fallback for PREFILL_API_BASE_URL only —
# CIBIL is served from a different host. It is commonly written with the
# /api/v1 suffix already on it; that is handled, and the resolved URL is shown
# on the test screen so you can confirm it.
# SUREPASS_BASE_URL=https://kyc-api.surepass.app/api/v1

# ---------------------------------------------------------------------------
# Optional. Defaults are in `src/lib/providers/config.ts`.
# ---------------------------------------------------------------------------

# Paths, if the provider moves an endpoint.
# PREFILL_API_PATH=/api/v1/prefill/prefill-by-mobile
# CIBIL_API_PATH=/api/v1/credit-report-cibil/fetch-report

# How each credential is presented.
#
# BOTH SCHEMES ARE CONFIRMED: Authorization: Bearer <token>. Prefill was
# confirmed by a live HTTP 200; CIBIL was specified and then confirmed the
# same way. The defaults below already match, so neither needs setting.
#
# They stay overridable because a provider that moves to an x-api-key style
# header should be a configuration change and nothing more:
#
#     PREFILL_AUTH_HEADER=x-api-key
#     PREFILL_AUTH_SCHEME=
#
# An empty scheme sends the credential bare under the named header.
# PREFILL_AUTH_HEADER=Authorization
# PREFILL_AUTH_SCHEME=Bearer
# CIBIL_AUTH_HEADER=Authorization
# CIBIL_AUTH_SCHEME=Bearer

# Per-request timeout, milliseconds.
# PROVIDER_TIMEOUT_MS=20000

# The consent flag the CIBIL endpoint requires. A constant, and NOT evidence
# of consent — see docs/api-integration.md before using real customer data.
# CIBIL_CONSENT_VALUE=Y
